# Copia in .env.local (non va nel repository) per lo sviluppo in locale.
# Solo valori pubblici per costruzione: mai chiavi segrete, service role o chiavi Stripe.
APP_ENV=development
EXPO_PUBLIC_SITE_URL=https://<anteprima-vercel>.vercel.app
EXPO_PUBLIC_SUPABASE_URL=https://<progetto>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<chiave anon>
# Facoltative
# EAS_PROJECT_ID=<creato da `eas init`>
# APPLE_TEAM_ID=<Team ID Apple>
# EXPO_PUBLIC_IOS_APP_STORE_ID=<id numerico dell'app su App Store, per «Aggiorna l'app»>
